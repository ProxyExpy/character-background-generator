		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.0",
		"@types/pg": "^8.16.0",
		"autoprefixer": "^10.4.24",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"postcss": "^8.5.6",
		"prettier": "^3.8.1",
